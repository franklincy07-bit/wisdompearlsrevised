{
  "name": "wisdom-pearls",
  "version": "0.0.0",
  "private": true,
  "description": "The Wisdom Pearls website, built with Astro and hosted on GitHub Pages.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
