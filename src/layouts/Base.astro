---
import "../styles/brand/base.css";
import "../styles/brand/wisdom-pearls.css";
import { link } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Wisdom Pearls" } = Astro.props;
const pageTitle = title ? `${title} · Wisdom Pearls` : "Wisdom Pearls";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Not launched: keep the site out of search engines (see public/robots.txt). */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-body);
    line-height: 1.6;
  }
  main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }
  h1,
  h2 {
    font-family: var(--font-heading);
    line-height: 1.2;
  }
  a {
    color: var(--color-accent);
  }
  .muted {
    color: var(--color-muted);
  }
</style>
